{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "Title": "Painel de Monitoramento Completo"
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "API Principal",
        "Uri": "http://api:8080/health"
      }
    ],
    "Webhooks": [
      {
        "Name": "Email SMTP (Mailtrap)",
        "Uri": "smtp://sandbox.smtp.mailtrap.io:2525",
        "Payload": "{\"subject\": \"🚨 Alerta de HealthCheck - {{HealthCheckName}}\", \"body\": \"O endpoint {{HealthCheckUri}} está com status {{HealthStatus}}\"}",
        "RestoredPayload": "{\"subject\": \"✅ Recuperado - {{HealthCheckName}}\", \"body\": \"O endpoint {{HealthCheckUri}} voltou ao status {{HealthStatus}}\"}"
      }
    ],
    "EvaluationTimeInSeconds": 15,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "ConnectionStrings": {
    "HealthChecksUI": "Data Source=/app/Data/healthchecks.db"
  }
}
